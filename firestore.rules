rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAnonymousUser() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /parents/{parentId} {
      allow read, create, update, delete: if signedInAs(parentId);
    }

    match /children/{childId} {
      allow read: if request.auth != null
          && (
            resource.data.parentIds.hasAny([request.auth.uid])
            || exists(
              /databases/$(database)/documents/children/$(childId)/childSessions/$(request.auth.uid)
            )
          );
      allow delete: if request.auth != null && !isAnonymousUser()
          && resource.data.parentIds.hasAny([request.auth.uid])
          && resource.data.parentIds.size() == 1;
      allow create: if request.auth != null && !isAnonymousUser()
          && request.resource.data.parentIds.hasAny([request.auth.uid]);
      allow update: if request.auth != null && !isAnonymousUser()
          && (
            (
              resource.data.parentIds.hasAny([request.auth.uid])
              && (
                request.resource.data.parentIds.hasAll(resource.data.parentIds)
                || (
                  !request.resource.data.parentIds.hasAny([request.auth.uid])
                  && resource.data.parentIds.size() == request.resource.data.parentIds.size() + 1
                  && resource.data.parentIds.hasAll(request.resource.data.parentIds)
                )
              )
            )
            || (
              !resource.data.parentIds.hasAny([request.auth.uid])
              && request.resource.data.parentIds.hasAny([request.auth.uid])
              && request.resource.data.parentIds.hasAll(resource.data.parentIds)
              && request.resource.data.parentIds.size() == resource.data.parentIds.size() + 1
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds'])
            )
          );

      match /childSessions/{sessionId} {
        allow read, delete: if request.auth != null
            && isAnonymousUser()
            && request.auth.uid == sessionId;
        allow create, update: if request.auth != null
            && isAnonymousUser()
            && request.auth.uid == sessionId
            && exists(/databases/$(database)/documents/children/$(childId));
      }
    }

    match /goals/{goalId} {
      allow read: if request.auth != null
          && (
            get(
              /databases/$(database)/documents/children/$(resource.data.childId)
            ).data.parentIds.hasAny([request.auth.uid])
            || (
              exists(
                /databases/$(database)/documents/children/$(resource.data.childId)
              )
              && exists(
              /databases/$(database)/documents/children/$(resource.data.childId)/childSessions/$(request.auth.uid)
              )
            )
          );
      allow delete: if request.auth != null
          && !isAnonymousUser()
          && get(
            /databases/$(database)/documents/children/$(resource.data.childId)
          ).data.parentIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null && !isAnonymousUser()
          && request.resource.data.parentId == request.auth.uid
          && request.resource.data.childId in get(
            /databases/$(database)/documents/parents/$(request.auth.uid)
          ).data.childIds;
      allow update: if request.auth != null && !isAnonymousUser()
          && resource.data.childId == request.resource.data.childId
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.childId in get(
            /databases/$(database)/documents/parents/$(request.auth.uid)
          ).data.childIds
          && (
            resource.data.parentId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['completedTasks'])
          );
    }
  }
}
